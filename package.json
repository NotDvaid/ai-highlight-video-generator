{
  "name": "ai-video-generator",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently \"npm run frontend\" \"npm run backend\" \"npm run minio\"",
    "frontend": "cd frontend && npm run dev",
    "backend": "python -m uvicorn ai_service.server:app --reload",
    "minio": "cd storage && .\\minio.exe server .\\minio-data --console-address :9001",
    "remotion": "remotion studio src/index.jsx",
    "render": "remotion render src/index.jsx MyVideo out.mp4"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.454",
    "@remotion/cli": "^4.0.454",
    "@remotion/renderer": "^4.0.454",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "multer": "^2.1.0",
    "remotion": "^4.0.454"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
